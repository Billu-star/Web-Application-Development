    <?php

    $str = "Hello PHP Programming";

    echo "<p><b>Original String:</b> $str</p>";

    echo "<p><b>String Length:</b> " .
         strlen($str) . "</p>";

    echo "<p><b>Word Count:</b> " .
         str_word_count($str) . "</p>";

    echo "<p><b>Uppercase:</b> " .
         strtoupper($str) . "</p>";

    echo "<p><b>Lowercase:</b> " .
         strtolower($str) . "</p>";

    echo "<p><b>Reverse String:</b> " .
         strrev($str) . "</p>";

    echo "<p><b>Replace PHP:</b> " .
         str_replace("PHP", "Web", $str) . "</p>";

    echo "<p><b>First 5 Characters:</b> " .
         substr($str, 0, 5) . "</p>";

