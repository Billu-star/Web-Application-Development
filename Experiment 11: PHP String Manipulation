
<!DOCTYPE html>
<html>
<head>
    <title>String Manipulation</title>

    <style>
        body {
            font-family: Arial;
            background: #eaf2f8;
            padding: 40px;
        }

        .container {
            max-width: 550px;
            margin: auto;
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 4px 15px #aaa;
        }

        h2 {
            text-align: center;
            color: #1a5276;
        }

        input {
            width: 100%;
            padding: 12px;
            box-sizing: border-box;
            margin: 12px 0;
            border: 1px solid #aaa;
            border-radius: 5px;
        }

        button {
            width: 100%;
            padding: 12px;
            background: #2471a3;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        button:hover {
            background: #154360;
        }

        #result {
            margin-top: 20px;
            background: #d5f5e3;
            padding: 15px;
            border-radius: 5px;
            overflow-wrap: anywhere;
        }
    </style>
</head>

<body>

<div class="container">

    <h2>String Manipulation</h2>

    <input type="text" id="str"
           placeholder="Enter a String">

    <button onclick="manipulate()">Perform Operations</button>

    <div id="result"></div>

</div>

<script>
    function manipulate() {

        var str = document.getElementById("str").value;

        if (str.trim() === "") {
            alert("Please enter a string");
            return;
        }

        var output = "";

        output += "<h3>String Operations</h3>";

        output += "Original String: " + escapeHTML(str) + "<br><br>";

        output += "Length: " + str.length + "<br><br>";

        output += "Uppercase: " + escapeHTML(str.toUpperCase()) + "<br><br>";

        output += "Lowercase: " + escapeHTML(str.toLowerCase()) + "<br><br>";

        output += "Reverse: " + escapeHTML(str.split("").reverse().join("")) + "<br><br>";

        output += "Word Count: " + str.trim().split(/\s+/).length + "<br><br>";

        output += "Replace PHP with Web: " +
            escapeHTML(str.replaceAll("PHP", "Web")) + "<br><br>";

        output += "First 5 Characters: " +
            escapeHTML(str.substring(0, 5));

        document.getElementById("result").innerHTML = output;
    }

    function escapeHTML(text) {
        return text.replace(/[&<>"']/g, function(char) {
            return {
                '&': '&amp;', '<': '&lt;', '>': '&gt;',
                '"': '&quot;', "'": '&#39;'
            }[char];
        });
    }
</script>

</body>
</html>
