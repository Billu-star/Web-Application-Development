
<!DOCTYPE html>
<html>
<head>
    <title>Image and Nested Table</title>
    <style>
        body {
            font-family: Arial;
            background-color: #eef5ff;
            text-align: center;
        }

        table {
            margin: auto;
            border-collapse: collapse;
            background: white;
            width: 70%;
        }

        th, td {
            border: 2px solid #333;
            padding: 12px;
        }

        th {
            background: #2878c8;
            color: white;
        }

        img {
            width: 180px;
            border-radius: 10px;
        }
    </style>
</head>
<body>

    <h1>My Favourite Website</h1>

    <img src="https://picsum.photos/300/200"
         alt="Sample Image">

    <p>
        <a href="https://www.google.com" target="_blank">
            Visit Google
        </a>
    </p>

    <h2>Student Information</h2>

    <table>
        <tr>
            <th>Name</th>
            <th>Details</th>
        </tr>

        <tr>
            <td>Rahul</td>
            <td>
                <table>
                    <tr>
                        <th>Subject</th>
                        <th>Marks</th>
                    </tr>
                    <tr>
                        <td>HTML</td>
                        <td>85</td>
                    </tr>
                    <tr>
                        <td>CSS</td>
                        <td>90</td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

</body>
</html>
