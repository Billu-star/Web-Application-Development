
<!DOCTYPE html>
<html>
<head>
    <title>Bootstrap Responsive Website</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>
        body {
            background-color: #eef4ff;
            font-family: Arial;
        }

        .card {
            border-radius: 15px;
            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-5px);
        }

        .heading {
            color: #174ea6;
        }
    </style>
</head>

<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container">
        <a class="navbar-brand" href="#">My Website</a>
    </div>
</nav>

<div class="container mt-5">

    <h1 class="text-center heading">Welcome to Bootstrap</h1>

    <p class="text-center">
        Learn HTML, CSS and JavaScript
    </p>

    <div class="row mt-4">

        <div class="col-md-4 mb-3">
            <div class="card shadow p-3 text-center">
                <h3 class="text-primary">HTML</h3>
                <p>HTML is used to create webpage structure.</p>
                <button class="btn btn-primary">Learn More</button>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow p-3 text-center">
                <h3 class="text-success">CSS</h3>
                <p>CSS is used to design webpages.</p>
                <button class="btn btn-success">Learn More</button>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow p-3 text-center">
                <h3 class="text-danger">JavaScript</h3>
                <p>JavaScript makes webpages interactive.</p>
                <button class="btn btn-danger">Learn More</button>
            </div>
        </div>

    </div>
</div>

<footer class="bg-dark text-white text-center p-3 mt-5">
    © 2026 My Website
</footer>

</body>
</html>
