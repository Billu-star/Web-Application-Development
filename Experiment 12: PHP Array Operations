    <?php

    $students = array(
        "Rahul" => 85,
        "Amit" => 90,
        "Sagar" => 95,
        "Priya" => 88,
        "Neha" => 92
    );

    echo "<h3>Student Marks</h3>";

    echo "<table>";

    echo "<tr>
            <th>Name</th>
            <th>Marks</th>
          </tr>";

    foreach ($students as $name => $marks) {

        echo "<tr>";
        echo "<td>$name</td>";
        echo "<td>$marks</td>";
        echo "</tr>";

    }

    echo "</table>";

    echo "<h3>Total Students: " .
         count($students) . "</h3>";

    echo "<h3>Total Marks: " .
         array_sum($students) . "</h3>";

    echo "<h3>Highest Marks: " .
         max($students) . "</h3>";

    ?>

</div>

