
<!DOCTYPE html>
<html>
<head>
    <title>PHP Array Operations</title>

    <style>
        body {
            background: #fff3e0;
            font-family: Arial;
            text-align: center;
        }

        .box {
            width: 600px;
            margin: 60px auto;
            padding: 30px;
            background: white;
            border-radius: 15px;
            box-shadow: 0 0 15px gray;
        }

        h2 {
            color: #e65100;
            font-size: 30px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th, td {
            padding: 15px;
            border: 1px solid black;
        }

        th {
            background: orange;
            color: white;
        }

        .result {
            font-size: 20px;
            font-weight: bold;
            margin-top: 20px;
        }
    </style>
</head>

<body>

<div class="box">

    <h2>PHP Array Operations</h2>

    <h3>Student Marks</h3>

    <table>
        <tr>
            <th>Name</th>
            <th>Marks</th>
        </tr>

        <tbody id="studentData"></tbody>
    </table>

    <div class="result" id="output"></div>

</div>

<script>

    // Creating an associative array
    var students = {
        "Rahul": 85,
        "Amit": 90,
        "Sagar": 95,
        "Priya": 88,
        "Neha": 92
    };

    var totalStudents = 0;
    var totalMarks = 0;
    var highestMarks = 0;

    var table = "";

    for (var name in students) {

        var marks = students[name];

        table += "<tr>";
        table += "<td>" + name + "</td>";
        table += "<td>" + marks + "</td>";
        table += "</tr>";

        totalStudents++;

        totalMarks += marks;

        if (marks > highestMarks) {
            highestMarks = marks;
        }
    }

    document.getElementById("studentData").innerHTML = table;

    document.getElementById("output").innerHTML =
        "Total Students: " + totalStudents +
        "<br><br>Total Marks: " + totalMarks +
        "<br><br>Highest Marks: " + highestMarks;

</script>

</body>
</html>
