

<!DOCTYPE html>
<html>
<head>
    <title>Types of CSS</title>

    <!-- Internal CSS -->
    <style>
        body {
            background-color: #eaf2ff;
            font-family: Arial, sans-serif;
            text-align: center;
        }

        h2 {
            color: green;
        }

        table {
            margin: auto;
            border-collapse: collapse;
            width: 60%;
            background-color: white;
        }

        th, td {
            border: 2px solid black;
            padding: 12px;
        }

        th {
            background-color: orange;
            color: white;
        }

        /* External-style CSS rules kept in this file */
        .info {
            color: blue;
            font-size: 20px;
            font-weight: bold;
        }
    </style>
</head>

<body>

    <!-- Inline CSS -->
    <h1 style="color:red;">
        Welcome to CSS
    </h1>

    <h2>Student Information</h2>

    <p class="info">
        CSS is used to design attractive webpages.
    </p>

    <table>
        <tr>
            <th>Name</th>
            <th>Subject</th>
        </tr>

        <tr>
            <td>Rahul</td>
            <td>HTML</td>
        </tr>

        <tr>
            <td>Amit</td>
            <td>CSS</td>
        </tr>
    </table>

</body>
</html>

